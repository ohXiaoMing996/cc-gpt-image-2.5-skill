// cc-gpt-image-2.5-skill 配置示例 — 复制到 ~/.cc-gpt-image/config.json 并填入真实值
// 注释字段以 _ 开头，仅备注用途；改动立即生效。
{
  "api_key":    "sk-xxxxxxxxxxxxxxxx",
  "base_url":   "https://api.openai.com/v1",
  "provider":   "openai",
  "model":      "gpt-image-2.5-flare",
  "_备注":       "api_key 必填；base_url 末尾不要带斜杠；provider 默认 openai，需要 AI Hive 异步任务时改 ai-hive 并把 model 换成 public_model_gpt_image_2"
}
